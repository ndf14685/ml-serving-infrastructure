# ============================================================
# .env.example — Plantilla de variables de entorno
#
# 🧒 PARA NIÑOS: Este archivo es como una lista de ingredientes
# para una receta, pero sin los ingredientes reales. Te dice
# QUÉ necesitas, pero TÚ tienes que poner los valores secretos.
#
# 📘 INSTRUCCIONES: Copia este archivo como ".env" y llena
# los valores. NUNCA commitees el archivo .env al repositorio.
# ============================================================

# ---- INFERENCE API ----------------------------------------
# Clave secreta para autenticar requests a la API
API_KEY=change-me-to-a-strong-random-secret

# Puerto donde escucha la API de inferencia
API_PORT=8000

# URLs internas de los otros servicios (en Docker/K8s usan el nombre del servicio)
PREPROCESSING_SERVICE_URL=http://preprocessing-service:8001
MODEL_MANAGER_URL=http://model-manager:8002

# Nivel de detalle de los logs (DEBUG|INFO|WARNING|ERROR)
LOG_LEVEL=INFO

# Entorno de ejecución (development|staging|production)
ENVIRONMENT=development

# ---- PREPROCESSING SERVICE --------------------------------
PREPROCESSING_PORT=8001

# ---- MODEL MANAGER ----------------------------------------
MODEL_MANAGER_PORT=8002

# Ruta dentro del contenedor donde está el modelo serializado
MODEL_PATH=/app/models/iris_model.pkl

# Versión del modelo actualmente en uso
MODEL_VERSION=1.0.0

# ---- MONITORING -------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Contraseña del admin de Grafana (¡cámbiala en producción!)
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# ---- KUBERNETES / CI-CD -----------------------------------
# Namespace de Kubernetes donde se despliegan los servicios
K8S_NAMESPACE=ml-serving

# Registry de imágenes Docker (ej: ghcr.io/tu-usuario)
REGISTRY=ghcr.io/ndf14685

# Versión de la imagen a desplegar
IMAGE_TAG=latest
